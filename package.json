{
  "name": "portpatrol",
  "version": "0.1.0",
  "description": "Map local development ports before your agents trip over them.",
  "type": "module",
  "bin": {
    "portpatrol": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "docs:check": "node scripts/check-doc-installs.mjs",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:smoke": "bash scripts/package-smoke.sh",
    "release:check": "npm run docs:check && npm run check && npm test && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "ports",
    "cli",
    "devtools",
    "localhost",
    "agents",
    "docker-compose"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/portpatrol.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/portpatrol/issues"
  },
  "homepage": "https://github.com/rogerchappel/portpatrol#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3"
  }
}
